<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="Business_App_Dev.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <title><%: Page.Title %> - EcoEats</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="<%= ResolveUrl("~/Content/EcoEats.css") %>" rel="stylesheet" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>

<body>
<form id="form1" runat="server">

    <header class="ee-topbar">
        <div class="ee-container ee-topbar-inner">

            <div class="ee-brand" data-notranslate="1">
                <div class="ee-logo">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M19 3c-6.5.7-11 3.8-13.8 7.2C2.6 13.4 2.2 17.2 4 21c3.8 1.8 7.6 1.4 10.8-1.2C18.2 17 21.3 12.5 22 6c.1-1.2-.7-2.9-3-3z"></path>
                    </svg>
                </div>
                <div class="ee-brand-name">EcoEats</div>
            </div>

            <nav class="ee-navlinks">
                <a href="Product.aspx" id="navHome" runat="server">Home</a>
                <a href="OrderHistory.aspx" id="navOrders" runat="server">Orders</a>
                <a href="About.aspx" id="navAbout" runat="server">About Us</a>
                <a href="Product.aspx?openHelp=1" id="navHelp" runat="server">Help</a>
                <a href="Feedback.aspx" id="navFeedback" runat="server">Feedback</a>
            </nav>

            <div class="ee-actions">
                <asp:DropDownList
                    ID="ddlLanguage"
                    runat="server"
                    CssClass="ee-lang"
                    AutoPostBack="true"
                    OnSelectedIndexChanged="ddlLanguage_SelectedIndexChanged">
                    <asp:ListItem Value="en">EN</asp:ListItem>
                    <asp:ListItem Value="zh">中文</asp:ListItem>
                    <asp:ListItem Value="ms">BM</asp:ListItem>
                    <asp:ListItem Value="ta">TA</asp:ListItem>
                </asp:DropDownList>

                <a class="ee-icon-btn" href="#" title="Notifications">🔔</a>
                <a class="ee-icon-btn" href="Cart.aspx" title="Cart">🛒</a>
                <a class="ee-icon-btn" href="Profile.aspx" title="Account">👤</a>
            </div>

        </div>
    </header>

    <main class="ee-page">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>

    <footer class="lp-footer">
        <div class="lp-footer-inner">

            <div>
                <div class="lp-brand">
                    <span class="lp-brand-badge">🌱</span>
                    <span id="ftBrandName" runat="server" data-notranslate="1">EcoEats</span>
                </div>

                <p id="ftDesc" runat="server">
                    EcoEats connects users with surplus meals from local sellers — helping you save money while reducing food waste.
                </p>
            </div>

            <div class="lp-links">
                <a href="Product.aspx" id="ftBrowse" runat="server">Browse Deals</a>
                <a href="OrderHistory.aspx" id="ftYourOrders" runat="server">Your Orders</a>
                <a href="About.aspx" id="ftAbout" runat="server">About EcoEats</a>
                <a href="Feedback.aspx" id="ftFeedback" runat="server">Feedback</a>
                <a href="Profile.aspx" id="ftProfile" runat="server">Profile</a>
                <a href="SellerSignup.aspx" id="ftSeller" runat="server">Become a Seller</a>
            </div>

        </div>

        <div class="lp-footnote">
            <div>© <%: DateTime.Now.Year %> EcoEats. All rights reserved.</div>
            <div id="ftNote2" runat="server">
                Made for NYP DBFT • Enterprise Dev Project
            </div>
        </div>
    </footer>

    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />

    <script>
    (function () {
      const lang = "<%= (Session["LANG"] ?? "en").ToString() %>".toLowerCase();
      if (!lang || lang === "en") return;

      const ENDPOINT = "<%= ResolveUrl("~/TranslateHandler.ashx") %>";
            const SKIP_TAGS = new Set(["SCRIPT", "STYLE", "NOSCRIPT", "IFRAME", "TEXTAREA", "CODE", "PRE"]);
            const CACHE_KEY = "ee_trans_cache_" + lang;

            const norm = (s) => (s == null ? "" : String(s)).replace(/\s+/g, " ").trim();
            const cache = (() => {
                try { return JSON.parse(sessionStorage.getItem(CACHE_KEY) || "{}"); } catch { return {}; }
            })();
            const saveCache = () => {
                try { sessionStorage.setItem(CACHE_KEY, JSON.stringify(cache)); } catch { }
            };

            function shouldSkipElement(el) {
                if (!el || el.nodeType !== 1) return true;
                if (SKIP_TAGS.has(el.tagName)) return true;
                if (el.closest && el.closest("[data-notranslate='1']")) return true;
                return false;
            }

            function collectTargets(root) {
                const textNodes = [];
                const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
                    acceptNode(n) {
                        const raw = n.nodeValue;
                        if (!raw) return NodeFilter.FILTER_REJECT;
                        const t = norm(raw);
                        if (!t) return NodeFilter.FILTER_REJECT;
                        const p = n.parentElement;
                        if (!p || shouldSkipElement(p)) return NodeFilter.FILTER_REJECT;
                        return NodeFilter.FILTER_ACCEPT;
                    }
                });
                while (walker.nextNode()) textNodes.push(walker.currentNode);

                const attrTargets = [];
                const els = root.querySelectorAll ? root.querySelectorAll("input,button,a,[title],[placeholder]") : [];
                els.forEach(el => {
                    if (shouldSkipElement(el)) return;

                    const ph = el.getAttribute && el.getAttribute("placeholder");
                    if (ph && norm(ph)) attrTargets.push({ el, attr: "placeholder", text: norm(ph) });

                    const tt = el.getAttribute && el.getAttribute("title");
                    if (tt && norm(tt)) attrTargets.push({ el, attr: "title", text: norm(tt) });

                    if (el.tagName === "INPUT") {
                        const type = (el.getAttribute("type") || "").toLowerCase();
                        if (type === "button" || type === "submit") {
                            const v = norm(el.value);
                            if (v) attrTargets.push({ el, attr: "value", text: v });
                        }
                    }
                });

                return { textNodes, attrTargets };
            }

            function applyTextNode(n, translated) {
                const raw = n.nodeValue || "";
                const leading = raw.match(/^\s*/)?.[0] || "";
                const trailing = raw.match(/\s*$/)?.[0] || "";
                n.nodeValue = leading + translated + trailing;
            }

            let inFlight = null;
            async function translateBatch(textNodes, attrTargets) {
                const need = [];
                const seen = new Set();

                for (const n of textNodes) {
                    const key = norm(n.nodeValue);
                    if (!key) continue;
                    if (cache[key]) continue;
                    if (!seen.has(key)) { seen.add(key); need.push(key); }
                }

                for (const a of attrTargets) {
                    const key = a.text;
                    if (!key) continue;
                    if (cache[key]) continue;
                    if (!seen.has(key)) { seen.add(key); need.push(key); }
                }

                if (need.length) {
                    if (!inFlight) {
                        inFlight = fetch(ENDPOINT, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ targetLang: lang, texts: need })
                        })
                            .then(r => r.ok ? r.json() : Promise.reject(new Error("HTTP " + r.status)))
                            .then(data => {
                                const dst = data && data.translations ? data.translations : [];
                                for (let i = 0; i < need.length; i++) {
                                    const src = need[i];
                                    const tr = norm(dst[i] || src);
                                    cache[src] = tr || src;
                                }
                                saveCache();
                            })
                            .finally(() => { inFlight = null; });
                    }
                    await inFlight;
                }

                for (const n of textNodes) {
                    const key = norm(n.nodeValue);
                    if (!key) continue;
                    const tr = cache[key];
                    if (tr && tr !== key) applyTextNode(n, tr);
                }

                for (const a of attrTargets) {
                    const tr = cache[a.text];
                    if (tr && tr !== a.text) {
                        if (a.attr === "value") a.el.value = tr;
                        else a.el.setAttribute(a.attr, tr);
                    }
                }
            }

            let scheduled = false;
            function scheduleTranslate(root) {
                if (scheduled) return;
                scheduled = true;
                setTimeout(async () => {
                    scheduled = false;
                    try {
                        const { textNodes, attrTargets } = collectTargets(root || document.body);
                        await translateBatch(textNodes, attrTargets);
                    } catch (e) { }
                }, 60);
            }

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", () => scheduleTranslate(document.body), { once: true });
            } else {
                scheduleTranslate(document.body);
            }

            const mo = new MutationObserver((mutations) => {
                for (const m of mutations) {
                    for (const node of m.addedNodes || []) {
                        if (!node) continue;
                        if (node.nodeType === 3) {
                            const p = node.parentElement;
                            if (p && !shouldSkipElement(p)) scheduleTranslate(p);
                        } else if (node.nodeType === 1) {
                            if (!shouldSkipElement(node)) scheduleTranslate(node);
                        }
                    }
                }
            });
            mo.observe(document.body, { childList: true, subtree: true });
        })();
    </script>

</form>
</body>
</html>