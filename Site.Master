<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="SellPage.master.cs"
    Inherits="Business_App_Dev.SellPage" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <title><%: Page.Title %> - EcoEats</title>

  
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />

   
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>

<body>
    <form id="form1" runat="server">
        <div class="ee-page">

            
            <header class="ee-header">
                <div class="container ee-header-main">
                    <div class="ee-logo">
                        <div class="ee-logo-icon">🌱</div>
                        <span class="ee-logo-text">EcoEats</span>
                    </div>

                    <div class="ee-search-wrapper">
                        <input type="text" class="ee-search-input"
                               placeholder="Search for meals, restaurants..." />
                    </div>

                    <div class="ee-header-icons">
                        <button type="button" class="ee-icon-btn">💬</button>
                        <button type="button" class="ee-icon-btn">📦</button>
                        <button type="button" class="ee-icon-btn">🛒</button>
                        <button type="button" class="ee-icon-btn">👤</button>
                    </div>
                </div>

                <nav class="ee-nav">
                    <div class="container ee-nav-links">
                        <a href="Default.aspx" class="ee-nav-link ee-nav-active">Home</a>
                        <a href="#" class="ee-nav-link">Orders</a>
                        <a href="#" class="ee-nav-link">Profile</a>
                        <a href="#" class="ee-nav-link">About Us</a>
                        <a href="#" class="ee-nav-link">Help</a>
                        <a href="#" class="ee-nav-link">Feedback</a>
                        <a href="#" class="ee-nav-link">Rate Sellers</a>
                    </div>
                </nav>
            </header>

            <main class="ee-main">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>

           
            <button type="button" class="ee-chat-fab">💬</button>

        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />
</body>
</html>
