<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="Business_App_Dev.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <title><%: Page.Title %> - EcoEats</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="<%= ResolveUrl("~/Content/EcoEats.css") %>" rel="stylesheet" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>

<body>
<form id="form1" runat="server">

    <header class="ee-topbar">
        <div class="ee-container ee-topbar-inner">

            <div class="ee-brand" data-notranslate="1">
                <div class="ee-logo">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M19 3c-6.5.7-11 3.8-13.8 7.2C2.6 13.4 2.2 17.2 4 21c3.8 1.8 7.6 1.4 10.8-1.2C18.2 17 21.3 12.5 22 6c.1-1.2-.7-2.9-3-3z"></path>
                    </svg>
                </div>
                <div class="ee-brand-name">EcoEats</div>
            </div>

            <!-- Search REMOVED -->

            <nav class="ee-navlinks">
                <a href="Product.aspx" id="navHome" runat="server">Home</a>
                <a href="OrderHistory.aspx" id="navOrders" runat="server">Orders</a>
                <a href="About.aspx" id="navAbout" runat="server">About Us</a>
                <a href="Help.aspx" id="navHelp" runat="server">Help</a>
                <a href="Feedback.aspx" id="navFeedback" runat="server">Feedback</a>
            </nav>

            <div class="ee-actions">
                <asp:DropDownList
                    ID="ddlLanguage"
                    runat="server"
                    CssClass="ee-lang"
                    AutoPostBack="true"
                    OnSelectedIndexChanged="ddlLanguage_SelectedIndexChanged">
                    <asp:ListItem Value="en">EN</asp:ListItem>
                    <asp:ListItem Value="zh">中文</asp:ListItem>
                    <asp:ListItem Value="ms">BM</asp:ListItem>
                    <asp:ListItem Value="ta">TA</asp:ListItem>
                </asp:DropDownList>

                <a class="ee-icon-btn" href="#" title="Notifications">🔔</a>
                <a class="ee-icon-btn" href="Cart.aspx" title="Cart">🛒</a>
                <a class="ee-icon-btn" href="Profile.aspx" title="Account">👤</a>
            </div>

        </div>
    </header>

    <main class="ee-page">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>

    <footer class="lp-footer">
        <div class="lp-footer-inner">

            <div>
                <div class="lp-brand">
                    <span class="lp-brand-badge">🌱</span>
                    <span id="ftBrandName" runat="server" data-notranslate="1">EcoEats</span>
                </div>

                <p id="ftDesc" runat="server">
                    EcoEats connects users with surplus meals from local sellers — helping you save money while reducing food waste.
                </p>
            </div>

            <div class="lp-links">
                <a href="Product.aspx" id="ftBrowse" runat="server">Browse Deals</a>
                <a href="OrderHistory.aspx" id="ftYourOrders" runat="server">Your Orders</a>
                <a href="About.aspx" id="ftAbout" runat="server">About EcoEats</a>
                <a href="Feedback.aspx" id="ftFeedback" runat="server">Feedback</a>
                <a href="Profile.aspx" id="ftProfile" runat="server">Profile</a>
                <a href="SellerSignup.aspx" id="ftSeller" runat="server">Become a Seller</a>
            </div>

        </div>

        <div class="lp-footnote">
            <div>© <%: DateTime.Now.Year %> EcoEats. All rights reserved.</div>
            <div id="ftNote2" runat="server">
                Made for NYP DBFT • Enterprise Dev Project
            </div>
        </div>
    </footer>

    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />

    <!-- AUTO TRANSLATE WHOLE PAGE -->
    <script>
        (function () {
            const lang = "<%= (Session["LANG"] ?? "en").ToString() %>".toLowerCase();
        if (!lang || lang === "en") return;

        const SKIP_TAGS = new Set(["SCRIPT", "STYLE", "NOSCRIPT", "IFRAME", "TEXTAREA", "CODE", "PRE"]);
        const norm = s => (s || "").replace(/\s+/g, " ").trim();

        function skip(el) {
            if (!el || el.nodeType !== 1) return true;
            if (SKIP_TAGS.has(el.tagName)) return true;
            if (el.closest && el.closest("[data-notranslate='1']")) return true;
            return false;
        }

        const textNodes = [];
        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
            acceptNode(n) {
                const t = norm(n.nodeValue);
                if (!t) return NodeFilter.FILTER_REJECT;
                const p = n.parentElement;
                if (!p || skip(p)) return NodeFilter.FILTER_REJECT;
                return NodeFilter.FILTER_ACCEPT;
            }
        });
        while (walker.nextNode()) textNodes.push(walker.currentNode);

        const attrTargets = [];
        document.querySelectorAll("input,button,a,[title],[placeholder]").forEach(el => {
            if (skip(el)) return;
            const ph = el.getAttribute && el.getAttribute("placeholder");
            if (ph && norm(ph)) attrTargets.push({ el, attr: "placeholder", text: norm(ph) });
            const tt = el.getAttribute && el.getAttribute("title");
            if (tt && norm(tt)) attrTargets.push({ el, attr: "title", text: norm(tt) });
            if (el.tagName === "INPUT") {
                const type = (el.getAttribute("type") || "").toLowerCase();
                if (type === "button" || type === "submit") {
                    const v = norm(el.value);
                    if (v) attrTargets.push({ el, attr: "value", text: v });
                }
            }
        });

        const all = [];
        textNodes.forEach(n => all.push(norm(n.nodeValue)));
        attrTargets.forEach(a => all.push(a.text));

        const uniq = [];
        const seen = new Set();
        all.forEach(t => { if (!seen.has(t)) { seen.add(t); uniq.push(t); } });

        fetch("<%= ResolveUrl("~/TranslateHandler.ashx") %>", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ targetLang: lang, texts: uniq })
            })
                .then(r => r.json())
                .then(data => {
                    const dst = data.translations || [];
                    const map = new Map();
                    for (let i = 0; i < uniq.length; i++) map.set(uniq[i], norm(dst[i] || uniq[i]));

                    textNodes.forEach(n => {
                        const o = norm(n.nodeValue);
                        const t = map.get(o) || o;
                        if (t !== o) n.nodeValue = n.nodeValue.replace(o, t);
                    });

                    attrTargets.forEach(a => {
                        const t = map.get(a.text) || a.text;
                        if (t !== a.text) {
                            if (a.attr === "value") a.el.value = t;
                            else a.el.setAttribute(a.attr, t);
                        }
                    });
                });
        })();
    </script>

    <!-- ===== Help Chat (OpenAI) ===== -->
    <div id="eeChatFab" style="position:fixed; right:18px; bottom:18px; z-index:99999;">
        <button type="button" id="eeChatOpenBtn"
            style="width:54px;height:54px;border-radius:999px;border:none;cursor:pointer;background:#16a34a;color:#fff;font-weight:900;box-shadow:0 12px 30px rgba(0,0,0,.18);">
            ?
        </button>
    </div>

    <div id="eeChatPanel" style="position:fixed;right:18px;bottom:84px;width:340px;max-width:calc(100vw - 36px);
        background:#fff;border:1px solid #e5e7eb;border-radius:16px;overflow:hidden;box-shadow:0 18px 40px rgba(0,0,0,.18);
        z-index:99999;display:none;">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:12px;background:#111827;color:#fff;">
            <div style="font-weight:900;">EcoEats Help</div>
            <button type="button" id="eeChatCloseBtn" style="border:none;background:transparent;color:#fff;font-size:18px;cursor:pointer;">✕</button>
        </div>

        <div id="eeChatMsgs" style="height:320px;overflow:auto;padding:12px;background:#f9fafb;">
            <div style="display:flex;gap:10px;margin-bottom:10px;">
                <div style="max-width:85%;padding:10px 12px;border-radius:14px;background:#fff;border:1px solid #e5e7eb;">
                    Hi 👋 Ask me anything about EcoEats (orders, sellers, checkout, location, etc.).
                </div>
            </div>
        </div>

        <div style="display:flex;gap:8px;padding:10px;border-top:1px solid #e5e7eb;background:#fff;">
            <input id="eeChatInput" type="text" placeholder="Type your question…"
                style="flex:1;border:1px solid #e5e7eb;border-radius:12px;padding:10px 12px;outline:none;" />
            <button type="button" id="eeChatSendBtn"
                style="border:none;background:#16a34a;color:#fff;font-weight:900;border-radius:12px;padding:10px 14px;cursor:pointer;">
                Send
            </button>
        </div>
    </div>

    <script>
        (function () {
            var openBtn = document.getElementById("eeChatOpenBtn");
            var closeBtn = document.getElementById("eeChatCloseBtn");
            var panel = document.getElementById("eeChatPanel");
            var msgs = document.getElementById("eeChatMsgs");
            var input = document.getElementById("eeChatInput");
            var sendBtn = document.getElementById("eeChatSendBtn");

            function bubble(text, me) {
                var row = document.createElement("div");
                row.style.display = "flex";
                row.style.marginBottom = "10px";
                row.style.justifyContent = me ? "flex-end" : "flex-start";

                var b = document.createElement("div");
                b.style.maxWidth = "85%";
                b.style.padding = "10px 12px";
                b.style.borderRadius = "14px";
                b.style.whiteSpace = "pre-wrap";
                b.style.wordBreak = "break-word";

                if (me) {
                    b.style.background = "#16a34a";
                    b.style.color = "#fff";
                    b.style.fontWeight = "800";
                } else {
                    b.style.background = "#fff";
                    b.style.border = "1px solid #e5e7eb";
                    b.style.color = "#111827";
                }

                b.textContent = text;
                row.appendChild(b);
                msgs.appendChild(row);
                msgs.scrollTop = msgs.scrollHeight;
            }

            async function send() {
                var q = (input.value || "").trim();
                if (!q) return;

                bubble(q, true);
                input.value = "";

                try {
                    var resp = await fetch("<%= ResolveUrl("~/HelpChat.ashx") %>", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ message: q })
                    });

                    var data = await resp.json();
                    bubble((data && data.answer) ? data.answer : "No answer.", false);
                } catch (e) {
                    bubble("Sorry—server error.", false);
                }
            }

            openBtn.onclick = function () { panel.style.display = "block"; setTimeout(function () { input.focus(); }, 50); };
            closeBtn.onclick = function () { panel.style.display = "none"; };
            sendBtn.onclick = send;
            input.addEventListener("keydown", function (e) { if (e.key === "Enter") send(); });
        })();
    </script>

</form>
</body>
</html>