<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="SellPage.master.cs"
    Inherits="Business_App_Dev.SellPage" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <style>
       /* ===== Seller topbar: match Site.Master one-row layout ===== */
.ee-topbar .ee-topbar-inner.seller{
  display:flex;
  align-items:center;
  gap:18px;
}

/* Small seller badge under EcoEats */
.ee-seller-badge{
  font-size:12px;
  font-weight:700;
  color:#6b7280;
  margin-top:2px;
}

/* Reuse ee-search look; just ensure it behaves like customer topbar */
.ee-topbar .ee-search{
  flex: 1;
  min-width: 280px;
  display:flex;
  align-items:center;
  gap:10px;
}

/* Make seller nav use same "link row" style as Site.Master */
.ee-navlinks.seller-navlinks{
  display:flex;
  align-items:center;
  gap:18px;
  white-space:nowrap;
}

/* Responsive like Site.Master */
@media (max-width: 1000px){
  .ee-topbar .ee-topbar-inner.seller{
    flex-wrap:wrap;
  }
  .ee-topbar .ee-search{
    order: 3;
    flex-basis: 100%;
  }
  .ee-navlinks.seller-navlinks{
    order: 4;
    flex-basis: 100%;
    overflow:auto;
    padding-bottom:6px;
  }
}

    </style>
    <meta charset="utf-8" />
    <title><%: Page.Title %> - EcoEats Seller</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- EcoEats CSS -->
    <link href="<%= ResolveUrl("~/Content/EcoEats.css") %>" rel="stylesheet" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Page-specific head -->
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>

<body>
<form id="form1" runat="server">

    <!-- SELLER TOP BAR (match Site.Master UI) -->
<header class="ee-topbar">
    <div class="ee-container ee-topbar-inner seller">

        <!-- Brand -->
        <div class="ee-brand">
            <div class="ee-logo">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19 3c-6.5.7-11 3.8-13.8 7.2C2.6 13.4 2.2 17.2 4 21c3.8 1.8 7.6 1.4 10.8-1.2C18.2 17 21.3 12.5 22 6c.1-1.2-.7-2.9-3-3z"></path>
                </svg>
            </div>

            <div>
                <div class="ee-brand-name">EcoEats</div>
                <div class="ee-seller-badge">Seller Portal</div>
            </div>
        </div>

        

        <!-- Seller NAV (same links, just styled like Site.Master nav) -->
        <nav class="ee-navlinks seller-navlinks">
            <a href="SellerDashboard.aspx">Dashboard</a>
            <a href="OrderManagement.aspx">Orders</a>
            <a href="Inventory.aspx">Inventory</a>
            <a href="SellerWasteTracker.aspx">Waste Tracker</a>
            <a href="SellerFeedback.aspx">Feedback</a>
            <a href="SellerMessages.aspx">Messages</a>
            <a href="StoreDetails.aspx">Store Profile</a>
        </nav>

        <!-- Actions (same icons) -->
        <div class="ee-actions">
            <a class="ee-icon-btn" href="SellerMessages.aspx" title="Messages">💬</a>
            <a class="ee-icon-btn" href="Inventory.aspx" title="Inventory">📦</a>
            <a class="ee-icon-btn" href="StoreDetails.aspx" title="Account">👤</a>
        </div>

    </div>
</header>

    <!-- MAIN CONTENT -->
    <main class="ee-container ee-main-wrap">
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
    </main>

    <!-- Floating chat -->
    <button type="button" class="ee-chat-fab">💬</button>

</form>
</body>
</html>
