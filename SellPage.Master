<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="SellPage.master.cs" Inherits="FoodSaver.SellPage" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <title><%: Page.Title %> - EcoEats</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />

    <!-- This placeholder is ONLY for page-specific HEAD items -->
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>

<body>
    <form id="form1" runat="server">
        <div class="ee-page">

            <header class="ee-header">

                <!-- Top bar (same as customer layout) -->
                <div class="container ee-header-main">
                    <div class="ee-logo">
                        <div class="ee-logo-icon">🌱</div>
                        <span class="ee-logo-text">EcoEats</span>
                        <span class="ms-2 fw-semibold text-muted">Seller</span>
                    </div>

                    <!-- Keep icons area for symmetry (optional) -->
                    <div class="ee-header-icons">
                        <a runat="server" href="Messages.aspx" class="ee-icon-btn" title="Messages">💬</a>
                        <a runat="server" href="SellerProfile.aspx" class="ee-icon-btn" title="Store Profile">👤</a>
                    </div>
                </div>

                <!-- Second row nav (same class names as customer) -->
                <nav class="ee-nav">
                    <div class="container ee-nav-links">
                        <a runat="server" href="SellerDashboard.aspx" class="ee-nav-link">Dashboard</a>
                        <a runat="server" href="SellerWasteTracker.aspx" class="ee-nav-link">Waste Tracker</a>
                        <a runat="server" href="Inventory.aspx" class="ee-nav-link">Inventory</a>
                        <a runat="server" href="SellerOrders.aspx" class="ee-nav-link">Order Management</a>
                        <a runat="server" href="ViewFeedback.aspx" class="ee-nav-link">View Feedback</a>
                        <a runat="server" href="SellerProfile.aspx" class="ee-nav-link">Store Profile</a>
                    </div>
                </nav>

            </header>

            <main class="ee-main">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </main>

            <button type="button" class="ee-chat-fab">💬</button>

        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

        <!-- Placeholder for page-specific scripts -->
        <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />
    </form>
</body>
</html>